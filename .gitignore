# macOS
.DS_Store

# Xcode
app/**/xcuserdata/
app/**/DerivedData/
app/**/*.xcuserstate
app/**/build/

# Blender
*.blend1
*.blend2

# Downloaded/purchased source assets — large, and not ours to redistribute.
# Licences and the manifest are tracked; the binaries are not.
assets/source/

# Video editing scratch
marketing/preview-video/**/Render Files/

# Xcode / SwiftPM
app/**/*.xcworkspace/xcuserdata/
app/**/.swiftpm/

# Downloaded reference material — regenerate with reference/fetch.sh
reference/apple-samples/
reference/practice-assets/

# Reality Composer Pro per-user editor state (camera history, open scenes)
*.rcuserdata

# Large binary assets — refetch with tools/fetch_assets.sh; licences are tracked
assets/hdri/*.hdr
assets/hdri/*.exr
assets/models/**/*.usdz
assets/models/**/*.usd
assets/audio/*
!assets/audio/.gitkeep

# Baked village meshes: 63 MB, regenerated by tools/merge_town.py from the
# source kit. Without them the generator falls back to unbatched references.
app/Packages/RealityKitContent/Sources/RealityKitContent/RealityKitContent.rkassets/village/merged/

# RCP working copies of individual houses, regenerated by tools/edit_house.py.
# The edits themselves live in assets/house_edits/ and ARE tracked.
app/house-edits/*.usda
