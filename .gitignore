# macOS
.DS_Store

# Xcode
app/**/xcuserdata/
app/**/DerivedData/
app/**/*.xcuserstate
app/**/build/

# Blender
*.blend1
*.blend2

# Large source archives (keep extracted originals, not zips)
assets/source/**/*.zip

# Video editing scratch
marketing/preview-video/**/Render Files/

# Xcode / SwiftPM
app/**/*.xcworkspace/xcuserdata/
app/**/.swiftpm/

# Downloaded reference material — regenerate with reference/fetch.sh
reference/apple-samples/
reference/practice-assets/

# Reality Composer Pro per-user editor state (camera history, open scenes)
*.rcuserdata
