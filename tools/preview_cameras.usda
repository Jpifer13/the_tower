#usda 1.0
(
    defaultPrim = "Preview"
    metersPerUnit = 1
    upAxis = "Y"
)

# Viewpoints for offline rendering with usdrecord. Not shipped — this exists so the
# room can be inspected from angles the visionOS simulator's fixed camera can't reach.

def Xform "Preview"
{
    def "Shell" (
        prepend references = @../app/Packages/RealityKitContent/Sources/RealityKitContent/RealityKitContent.rkassets/TowerShell.usda@
    )
    {
    }

    # Lit by the actual day HDRI, so this previews the planned image-based lighting
    # rather than some arbitrary preview light.
    def DomeLight "Sky"
    {
        asset inputs:texture:file = @../assets/hdri/kloofendal_38d_partly_cloudy-4k.hdr@
        float inputs:intensity = 1.0
        float3 xformOp:rotateXYZ = (0, 55, 0)
        uniform token[] xformOpOrder = ["xformOp:rotateXYZ"]
    }

    # Sun through the window, from the window side.
    def DistantLight "Sun"
    {
        float inputs:intensity = 3.0
        float inputs:angle = 0.53
        float3 xformOp:rotateXYZ = (-30, 55, 0)
        uniform token[] xformOpOrder = ["xformOp:rotateXYZ"]
    }

    # Standing back, whole room with furniture.
    def Camera "RoomWide"
    {
        float focalLength = 13
        float horizontalAperture = 36
        float3 xformOp:rotateXYZ = (-8, 0, 0)
        double3 xformOp:translate = (0, 1.70, 3.60)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:rotateXYZ"]
    }

    # Square on to the left candle stand, to check flames sit on the candles.
    def Camera "AtStand"
    {
        float focalLength = 45
        float horizontalAperture = 36
        float3 xformOp:rotateXYZ = (-6, 90, 0)
        double3 xformOp:translate = (-1.30, 1.55, 1.40)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:rotateXYZ"]
    }

    # Square on to the fireplace, which sits 55 degrees to the left.
    def Camera "AtFire"
    {
        float focalLength = 16
        float horizontalAperture = 36
        float3 xformOp:rotateXYZ = (-6, 180, 0)
        double3 xformOp:translate = (0.0, 1.65, 1.60)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:rotateXYZ"]
    }

    # The orb on its pedestal, from across the room.
    def Camera "AtOrb"
    {
        float focalLength = 24
        float horizontalAperture = 36
        float3 xformOp:rotateXYZ = (-10, 180, 0)
        double3 xformOp:translate = (0.0, 1.65, 0.30)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:rotateXYZ"]
    }

    # Down among the houses, to check they are assembled correctly.
    def Camera "VillageCheck"
    {
        float focalLength = 24
        float horizontalAperture = 36
        float3 xformOp:rotateXYZ = (-3, -72.0, 0)
        double3 xformOp:translate = (14.3, -24.2, -19.8)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:rotateXYZ"]
    }

    # High above the village, to check the whole plan.
    def Camera "VillageAbove"
    {
        float focalLength = 20
        float horizontalAperture = 36
        float3 xformOp:rotateXYZ = (-45, 0, 0)
        double3 xformOp:translate = (35.2, 20.0, 19.4)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:rotateXYZ"]
    }

    # Seated, looking at the desk and the props on it.
    def Camera "AtDesk"
    {
        float focalLength = 15
        float horizontalAperture = 36
        float3 xformOp:rotateXYZ = (-14, 0, 0)
        double3 xformOp:translate = (0, 1.15, 0.35)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:rotateXYZ"]
    }

    # Seated at the desk, looking at the wall — what you actually see most of the time.
    def Camera "Seated"
    {
        float focalLength = 20
        float horizontalAperture = 36
        double3 xformOp:translate = (0, 1.2, 0)
        uniform token[] xformOpOrder = ["xformOp:translate"]
    }

    # Standing, turned toward the window on your right.
    def Camera "ToWindow"
    {
        float focalLength = 20
        float horizontalAperture = 36
        float3 xformOp:rotateXYZ = (-5, -55, 0)
        double3 xformOp:translate = (0, 1.65, 0.5)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:rotateXYZ"]
    }

    # Looking up at the cone from the pacing area.
    def Camera "UpAtRoof"
    {
        float focalLength = 16
        float horizontalAperture = 36
        float3 xformOp:rotateXYZ = (40, 0, 0)
        double3 xformOp:translate = (0, 1.65, 3.6)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:rotateXYZ"]
    }

    # Flat on your back in the middle of the room, looking at the apex.
    def Camera "StraightUp"
    {
        float focalLength = 12
        float horizontalAperture = 36
        float3 xformOp:rotateXYZ = (90, 0, 0)
        double3 xformOp:translate = (0, 1.6, 3.14)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:rotateXYZ"]
    }

    # The whole opening, square on — all four reveal faces visible at once.
    def Camera "WindowWide"
    {
        float focalLength = 13
        float horizontalAperture = 36
        float3 xformOp:rotateXYZ = (0, -55, 0)
        double3 xformOp:translate = (-0.4, 1.85, 2.9)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:rotateXYZ"]
    }

    # Leaning out of the window, looking down the shaft. The parallax test.
    def Camera "LeanOut"
    {
        float focalLength = 15
        float horizontalAperture = 36
        float3 xformOp:rotateXYZ = (-68, -55, 0)
        double3 xformOp:translate = (4.15, 1.70, 0.24)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:rotateXYZ"]
    }

    # From outside the tower, looking back at the window opening.
    def Camera "Outside"
    {
        float focalLength = 32
        float horizontalAperture = 36
        float3 xformOp:rotateXYZ = (-8, 125, 0)
        double3 xformOp:translate = (24.1, 8.0, -13.7)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:rotateXYZ"]
    }

    # Standing at the window, close enough to read the reveal.
    def Camera "AtWindow"
    {
        float focalLength = 20
        float horizontalAperture = 36
        float3 xformOp:rotateXYZ = (-16, -60, 0)
        double3 xformOp:translate = (2.2, 1.70, 1.35)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:rotateXYZ"]
    }

    # Close on where the cone meets the stone, to inspect the junction.
    def Camera "Eaves"
    {
        float focalLength = 35
        float horizontalAperture = 36
        float3 xformOp:rotateXYZ = (25, 180, 0)
        double3 xformOp:translate = (0, 3.2, 0.5)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:rotateXYZ"]
    }

    # Wall, floor and cone together — the view for judging colour.
    def Camera "Corner"
    {
        float focalLength = 14
        float horizontalAperture = 36
        float3 xformOp:rotateXYZ = (10, 150, 0)
        double3 xformOp:translate = (0, 1.65, 4.2)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:rotateXYZ"]
    }

    # Cutaway from above and behind, to judge proportion as a whole.
    def Camera "Overview"
    {
        float focalLength = 18
        float horizontalAperture = 36
        float3 xformOp:rotateXYZ = (-38, 0, 0)
        double3 xformOp:translate = (0, 11.0, 11.0)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:rotateXYZ"]
    }
}
