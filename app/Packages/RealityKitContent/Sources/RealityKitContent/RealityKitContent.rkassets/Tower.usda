#usda 1.0
(
    defaultPrim = "Root"
    metersPerUnit = 1
    upAxis = "Y"
)

# Composition root — safe to edit in Reality Composer Pro.
# The shell it references is generated; see tools/generate_tower_shell.py.

def Xform "Root"
{
    def "Shell" (
        prepend references = @TowerShell.usda@
    )
    {
    }
}
