    def Material "HearthMat"
    {
        token outputs:surface.connect = </TowerShell/HearthMat/Surface.outputs:surface>
        def Shader "stReader"
        {
            uniform token info:id = "UsdPrimvarReader_float2"
            token inputs:varname = "st"
            float2 outputs:result
        }
        def Shader "diffuseTex"
        {
            uniform token info:id = "UsdUVTexture"
            asset inputs:file = @textures/wall_diff.jpg@
            float2 inputs:st.connect = </TowerShell/HearthMat/stReader.outputs:result>
            token inputs:wrapS = "repeat"
            token inputs:wrapT = "repeat"
            float4 inputs:scale = (0.8, 0.84, 0.92, 1)
            float3 outputs:rgb
        }
        def Shader "normalTex"
        {
            uniform token info:id = "UsdUVTexture"
            asset inputs:file = @textures/wall_nor.jpg@
            float2 inputs:st.connect = </TowerShell/HearthMat/stReader.outputs:result>
            token inputs:wrapS = "repeat"
            token inputs:wrapT = "repeat"
            token inputs:sourceColorSpace = "raw"
            float4 inputs:scale = (2, 2, 2, 1)
            float4 inputs:bias = (-1, -1, -1, 0)
            float3 outputs:rgb
        }
        def Shader "roughTex"
        {
            uniform token info:id = "UsdUVTexture"
            asset inputs:file = @textures/wall_rough.jpg@
            float2 inputs:st.connect = </TowerShell/HearthMat/stReader.outputs:result>
            token inputs:wrapS = "repeat"
            token inputs:wrapT = "repeat"
            token inputs:sourceColorSpace = "raw"
            float4 inputs:scale = (0.55, 0.55, 0.55, 1)
            float4 inputs:bias = (0.45, 0.45, 0.45, 0)
            float outputs:r
        }
        def Shader "Surface"
        {
            uniform token info:id = "UsdPreviewSurface"
            color3f inputs:diffuseColor.connect = </TowerShell/HearthMat/diffuseTex.outputs:rgb>
            normal3f inputs:normal.connect = </TowerShell/HearthMat/normalTex.outputs:rgb>
            float inputs:roughness.connect = </TowerShell/HearthMat/roughTex.outputs:r>
            float inputs:metallic = 0
            token outputs:surface
        }
    }
